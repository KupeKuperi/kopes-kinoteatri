[
  {"until": "/INSTALL THE ENGINE/i.test(document.body.innerText) || document.querySelector('nav')?.innerText.includes('Ready')", "timeout": 90000},
  {"wait": 1500},
  {"eval": "'start: ' + (/INSTALL THE ENGINE/i.test(document.body.innerText) ? 'first-run screen' : 'engine already there') + ' | platform ' + window.mb.platform"},
  {"shot": "probe/out/ci/01-first-run.png"},
  {"eval": "(() => { const b = [...document.querySelectorAll('button')].find(x => x.innerText.trim() === 'Install moviebox-tui'); if (!b) return 'no install button'; b.click(); return 'clicked Install moviebox-tui'; })()"},
  {"until": "document.querySelector('nav')?.innerText.includes('Ready') || /checksum|failed|HTTP/i.test(document.querySelector('.absolute.inset-0.z-50')?.innerText ?? '')", "timeout": 240000},
  {"wait": 3000},
  {"eval": "document.querySelector('nav')?.innerText.includes('Ready') ? 'ENGINE READY' : 'ENGINE NOT READY: ' + (document.querySelector('.absolute.inset-0.z-50')?.innerText ?? document.querySelector('nav')?.innerText ?? '').replace(/\\s+/g, ' ').slice(0, 300)"},
  {"eval": "'header: ' + document.querySelector('header').innerText.replace(/\\s+/g, ' ')"},
  {"evalFile": "probe/js/tui-screen.js"},
  {"until": "/TRENDING NOW|no Discover lists|Couldn/.test(document.querySelector('main')?.innerText ?? '')", "timeout": 60000},
  {"eval": "'discover: ' + ([...document.querySelectorAll('main section')].find(s => /^DISCOVER/.test(s.innerText))?.innerText.replace(/\\s+/g, ' ').slice(0, 400) ?? 'none')"},
  {"shot": "probe/out/ci/02-home.png"},
  {"eval": "document.getElementById('global-search').focus(); 'focused search'"},
  {"type": "Interstellar"},
  {"key": "Enter"},
  {"until": "!document.querySelector('main .grid .skeleton') && (document.querySelectorAll('main .grid button.marquee').length > 0 || /NOTHING FOUND|DIDN'T FINISH/.test(document.querySelector('main').innerText))", "timeout": 90000},
  {"wait": 3000},
  {"eval": "'search: ' + document.querySelector('main header')?.innerText.replace(/\\s+/g, ' ') + ' || ' + [...document.querySelectorAll('main .grid button.marquee')].slice(0, 4).map(b => b.innerText.replace(/\\s+/g, ' ')).join(' | ')"},
  {"shot": "probe/out/ci/03-search.png"},
  {"click": "main .grid button.marquee"},
  {"until": "!!document.querySelector('main h1') && (document.querySelectorAll('main table tbody tr').length > 0 || /couldn't|No streams|failed|Nothing is open/i.test(document.querySelector('main').innerText))", "timeout": 150000},
  {"wait": 3000},
  {"evalFile": "probe/js/details-summary.js"},
  {"shot": "probe/out/ci/04-details.png"},
  {"evalFile": "probe/js/tui-screen.js"},
  {"key": "5", "mod": 4},
  {"wait": 2000},
  {"eval": "'settings: ' + document.querySelector('main').innerText.replace(/\\s+/g, ' ').slice(0, 300)"},
  {"shot": "probe/out/ci/05-settings.png"}
]
